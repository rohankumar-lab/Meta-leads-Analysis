  return '<span class="verdict none">No evidence</span>';
}
const strengthCell = V => V == null ? '<span class="dim">–</span>' : `<span class="strength"><span class="bar"><i style="width:${Math.min(100, V/0.4*100)}%"></i></span>${V.toFixed(2)}</span>`;

/* ---------- render ---------- */
function render(){
  const rows = filtered();
  renderFunnel(rows);
  const base = outcomeBase(rows);
  const keys = questionKeys(base);
  const y = yfn(state.outcome);
  const tier = s => !s.testable ? 3 : s.p < 0.05 ? 0 : s.p < 0.2 ? 1 : 2;
  const stats = keys.map(k => qstats(base, k, y)).sort((a,b) => tier(a) - tier(b) || (b.V ?? -1) - (a.V ?? -1) || b.n - a.n);
  renderRank(rows, stats);
  renderImpact(stats);
  renderHeatPickers(stats);
  renderHeat(base);
  renderWeekly(rows);
  renderTables(rows);
}

function renderFunnel(rows){
  const n = rows.length, a = rows.filter(r=>r.assigned).length, o = rows.filter(r=>r.onboarded).length,
        f = rows.filter(r=>r.fls).length, act = rows.filter(r=>r.active).length;
  const st = [
    ['Form leads', n, null, null],
    ['Assigned', a, a/n, 'of leads'],
    ['Onboarded', o, a ? o/a : null, 'of assigned'],
    ['First lead shared', f, o ? f/o : null, 'of onboarded'],
    ['First active', act, f ? act/f : null, 'of first lead shared']
  ];
  $('funnel').innerHTML = st.map(([lab, v, c, of], i) => `
    <div class="stage${i===3?' key':''}"><div class="lab">${lab}</div><div class="num">${fmt(v)}</div>
    <div class="conv">${c==null ? (n ? 'in selected filters' : 'no leads in filters') : `<b>${pct(c)}</b> ${of}${i>1 && n ? ` · ${pct(v/n)} of leads` : ''}`}</div></div>`).join('');
  const today = todayIST();
  const stuck = rows.filter(r => !r.assigned && dayDiff(today, r.created) >= 1).length;
  const young = rows.filter(r => dayDiff(today, r.created) < 14).length;
  const t1 = rows.filter(r => r.onboarded && r.onbType === '1').length;
  const notes = [];
  notes.push(stuck ? `<span class="alert">${fmt(stuck)} leads unassigned for a day or more</span>` : 'No leads stuck unassigned');
  if (n) notes.push(`${pct(young/n,0)} of leads are under 14 days old`);
  if (t1) notes.push(`${t1} onboarded with onboarding_type 1`);
  if (window._meta.dupPhones) notes.push(`${window._meta.dupPhones} repeat phone submissions removed`);
  $('funnelNotes').innerHTML = notes.map(x => `<span>${x}</span>`).join('');
}

function renderRank(rows, stats){
  const base = outcomeBase(rows), y = yfn(state.outcome);
  const yes = base.filter(y).length;
  const denom = state.outcome === 'flsOnb' ? 'onboarded leads' : ($('fDen').value === 'assigned' ? 'assigned leads' : 'all leads');
  $('rankLede').innerHTML = `Across ${fmt(base.length)} ${denom}, ${fmt(yes)} ${OUTCOMES[state.outcome].short} (${pct(base.length ? yes/base.length : null)}). Questions with clear evidence come first, then by how strongly their answers split that outcome. Click a row to jump to its answers.` + (yes < 15 ? ` <b>Only ${yes} outcomes so far, so treat rankings as directional.</b>` : '');
  if (!stats.length){ $('rank').innerHTML = '<div class="empty">No form answers in the current filters. Widen the date range or clear a filter.</div>'; return; }
  // other-outcome strength for comparison
  const otherKey = state.outcome === 'onb' ? 'fls' : 'onb';
  const otherBase = otherKey === 'onb' || state.outcome === 'flsOnb' ? denomRows(rows) : denomRows(rows);
  const minN = +$('fMinN').value;
  const body = stats.map(s => {
    const o = qstats(otherBase, s.key, yfn(otherKey));
    const shown = s.answers.filter(x => x.n >= minN);
    const spread = s.yes > 0 && shown.length > 1 && shown[0].rate > shown[shown.length-1].rate;
    const best = spread ? shown[0] : null, worst = spread ? shown[shown.length-1] : null;
    return `<tr class="click" tabindex="0" data-k="${esc(s.key)}">
      <td><b>${esc(s.label)}</b><br><span class="dim">${s.answers.length} answers</span></td>
      <td>${fmt(s.n)}</td>
      <td>${strengthCell(s.V)}</td>
      <td>${verdict(s)}${s.testable && s.lowExpShare > 0.2 ? '<br><span class="dim" style="font-size:.72rem">small cells</span>' : ''}</td>
      <td style="text-align:left">${best ? `<span class="up">${esc(best.a)}</span> ${pct(best.rate)}` : '<span class="dim">–</span>'}</td>
      <td style="text-align:left">${worst ? `<span class="down">${esc(worst.a)}</span> ${pct(worst.rate)}` : '<span class="dim">–</span>'}</td>
      <td>${strengthCell(o.V)}</td>
    </tr>`;
  }).join('');
  $('rank').innerHTML = `<div class="tblwrap"><table>
    <thead><tr><th>Question</th><th>Answered</th><th>Strength for ${esc(OUTCOMES[state.outcome].label.toLowerCase())}</th><th>Evidence</th><th style="text-align:left">Best answer (${minN}+ leads)</th><th style="text-align:left">Worst answer</th><th>Strength for ${esc(OUTCOMES[otherKey].label.toLowerCase())}</th></tr></thead>
    <tbody>${body}</tbody></table></div>`;
  $('rank').querySelectorAll('tr.click').forEach(tr => {
    const go = () => { const el = document.getElementById('q-' + tr.dataset.k.replace(/[^\w]/g,'_')); if (el) el.scrollIntoView({behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block:'start'}); };
    tr.addEventListener('click', go); tr.addEventListener('keydown', e => { if (e.key === 'Enter') go(); });
  });
}

function niceMax(x){ const steps = [0.05,0.1,0.15,0.2,0.25,0.3,0.4,0.5,0.6,0.8,1]; return steps.find(s => s >= x) || 1; }
function renderImpact(stats){
  const minN = +$('fMinN').value;
  if (!stats.length){ $('impact').innerHTML = '<div class="empty">No answers to show for these filters.</div>'; return; }
  $('impact').innerHTML = stats.map(s => {
    const vis = s.answers.filter(x => x.n >= minN);
    const xmax = niceMax(Math.max(s.base, ...(vis.length ? vis : s.answers).map(x => x.hi)) * 1.02);
    const maxN = Math.max(...s.answers.map(x => x.n));
    const P = v => Math.min(100, v/xmax*100);
    const rowsHtml = s.answers.map(x => {
      const thin = x.n < minN;
      const col = thin ? 'var(--neu)' : x.lo > s.base ? 'var(--pos)' : x.hi < s.base ? 'var(--neg)' : 'var(--neu)';
      const size = 7 + 11*Math.sqrt(x.n/maxN);
      const lift = x.lift == null ? '' : x.lift >= 1 ? `<span class="${x.lo > s.base && !thin ? 'up' : 'dim'}">${x.lift.toFixed(1)}×</span>` : `<span class="${x.hi < s.base && !thin ? 'down' : 'dim'}">${x.lift.toFixed(1)}×</span>`;
      return `<div class="arow${thin?' thin':''}" title="${esc(x.a)}: ${x.y} of ${x.n} (${pct(x.rate)}), 95% range ${pct(x.lo)}–${pct(x.hi)}">
        <div class="al">${esc(x.a)}<br><span class="dim">${x.y} of ${x.n}</span></div>
        <div class="track"><div class="rail"></div>
          <div class="ci" style="left:${P(x.lo)}%;width:${Math.max(0.5, P(x.hi)-P(x.lo))}%;background:${col}"></div>
          <div class="base" style="left:${P(s.base)}%"></div>
          <div class="dot" style="left:${P(x.rate)}%;width:${size}px;height:${size}px;background:${col}"></div></div>
        <div class="num"><b>${pct(x.rate)}</b></div><div class="num">${lift}</div></div>`;
    }).join('');
    return `<div class="card" id="q-${s.key.replace(/[^\w]/g,'_')}">
      <h3>${esc(s.label)}</h3>
      <p class="meta">${fmt(s.n)} answered, ${fmt(s.yes)} ${OUTCOMES[state.outcome].short}, average ${pct(s.base)} ${s.V != null ? ` · strength ${s.V.toFixed(2)}` : ''}</p>
      <div class="arow head"><div>Answer</div><div class="axis"><span style="left:0">0%</span><span style="left:50%">${pct(xmax/2,0)}</span><span style="left:100%">${pct(xmax,0)}</span></div><div class="num">Rate</div><div class="num">vs avg</div></div>
      ${rowsHtml}</div>`;
  }).join('');
}

function renderHeatPickers(stats){
  const s1 = $('hQ1'), s2 = $('hQ2'), c1 = s1.value, c2 = s2.value;
  const opts = stats.map(s => `<option value="${esc(s.key)}">${esc(s.label)}</option>`).join('');
  s1.innerHTML = opts; s2.innerHTML = opts;
  const keys = stats.map(s => s.key);
  s1.value = keys.includes(c1) ? c1 : (keys[0] || '');
  if (keys.includes(c2) && c2 !== s1.value) s2.value = c2;
  else {
    // default to the strongest question that shares the most leads with the first one
    const base = outcomeBase(filtered()), k1 = s1.value;
    let best = '', bestN = -1;
    for (const k of keys){ if (k === k1) continue; const n = base.filter(r => r.answers[k1] != null && r.answers[k] != null).length; if (n > bestN * 1.5){ best = k; bestN = n; } }
    s2.value = best;
  }
}
function renderHeat(base){
  const k1 = $('hQ1').value, k2 = $('hQ2').value, minN = +$('fMinN').value, y = yfn(state.outcome);
  if (!k1 || !k2 || k1 === k2){ $('heat').innerHTML = '<div class="empty">Pick two different questions.</div>'; return; }
  const both = base.filter(r => r.answers[k1] != null && r.answers[k2] != null);
  if (both.length < 5){ $('heat').innerHTML = `<div class="empty">Only ${both.length} leads answered both questions. These two questions are probably on different form versions.</div>`; return; }
  const avg = both.filter(y).length / both.length;
  const cnt = (arr, k) => { const c = {}; arr.forEach(r => c[r.answers[k]] = (c[r.answers[k]]||0)+1); return Object.keys(c).sort((a,b)=>c[b]-c[a]); };
  const A = cnt(both, k1), B = cnt(both, k2);
  const cell = {}; both.forEach(r => { const key = r.answers[k1] + '\u0001' + r.answers[k2]; (cell[key] = cell[key] || {n:0,y:0}).n++; if (y(r)) cell[key].y++; });
  const td = (a, b) => {
    const c = cell[a + '\u0001' + b]; if (!c) return '<td class="thin">–</td>';
    const r = c.y/c.n;
    if (c.n < minN) return `<td class="thin">${pct(r,0)}<small>n=${c.n}</small></td>`;
    const diff = r - avg, inten = Math.min(1, Math.abs(diff)/Math.max(avg, 0.05));
    const bg = `rgba(var(${diff >= 0 ? '--pos-rgb' : '--neg-rgb'}),${(0.08 + 0.5*inten).toFixed(2)})`;
    return `<td class="cell" style="background:${bg}">${pct(r,0)}<small>${c.y} of ${c.n}</small></td>`;
  };
  $('heat').innerHTML = `<p class="lede" style="margin-bottom:.6rem">${fmt(both.length)} leads answered both. Average ${pct(avg)}. Cells under ${minN} leads are greyed.</p>
  <div class="tblwrap"><table class="heat"><thead><tr><th>${esc(qLabel(k1))} ↓ / ${esc(qLabel(k2))} →</th>${B.map(b => `<th>${esc(b)}</th>`).join('')}</tr></thead>
  <tbody>${A.map(a => `<tr><td>${esc(a)}</td>${B.map(b => td(a,b)).join('')}</tr>`).join('')}</tbody></table></div>`;
}

function cssVar(n){ return getComputedStyle(document.documentElement).getPropertyValue(n).trim(); }
const coh = {out:'onb', view:'pct'};
function renderWeekly(rows){
  const den = $('fDen').value === 'assigned';
  const cur = weekStart(todayIST());
  const wkIdx = (a, b) => Math.round((Date.parse(a) - Date.parse(b)) / (7*86400000));
  const dateOf = r => coh.out === 'onb' ? (r.onboarded ? (r.onbDate || r.created) : '') : (r.fls ? (r.flsDate || r.created) : '');
  const g = {};
  for (const r of rows){ if (den && !r.assigned) continue; const w = weekStart(r.created); (g[w] = g[w] || []).push(r); }
  const weeks = Object.keys(g).sort();
  if (!weeks.length){ $('cohort').innerHTML = '<div class="empty">No leads in the current filters.</div>'; return; }
  const maxK = wkIdx(cur, weeks[0]);
  const data = weeks.map(w => {
    const rs = g[w], reach = wkIdx(cur, w), cells = [];
    const offs = rs.map(r => { const d = dateOf(r); return d ? Math.max(0, wkIdx(weekStart(d), w)) : null; });
    for (let k = 0; k <= reach; k++) cells.push(offs.filter(o => o !== null && o <= k).length);
    return {w, n: rs.length, reach, cells};
  });
  const maxRate = Math.max(0.01, ...data.flatMap(d => d.cells.map(c => d.n ? c/d.n : 0)));
  const cellHtml = (c, n, prog) => {
    if (c == null) return '<td></td>';
    const r = n ? c/n : 0, a = (0.06 + 0.6 * r / maxRate).toFixed(2);
    const main = coh.view === 'pct' ? pct(r) : fmt(c);
    const sub = coh.view === 'pct' ? `${c} of ${n}` : pct(r);
    return `<td class="v${prog ? ' prog' : ''}" style="background:rgba(var(--pos-rgb),${a})" title="${c} of ${n} (${pct(r)})${prog ? ', week in progress' : ''}">${main}<small>${sub}</small></td>`;
  };
  const head = `<tr><th>Signup week</th><th style="text-align:right">${den ? 'Assigned leads' : 'Leads'}</th>${Array.from({length: maxK+1}, (_, k) => `<th>Week ${k}</th>`).join('')}</tr>`;
  const body = data.map(d => `<tr><td>${shortDate(d.w)}</td><td class="base">${fmt(d.n)}</td>${Array.from({length: maxK+1}, (_, k) => k <= d.reach ? cellHtml(d.cells[k], d.n, k === d.reach) : '<td></td>').join('')}</tr>`).join('');
  // weighted average over cohorts that have fully completed week k
  const avg = Array.from({length: maxK+1}, (_, k) => {
    const done = data.filter(d => d.reach > k);
    const n = done.reduce((s, d) => s + d.n, 0), c = done.reduce((s, d) => s + d.cells[k], 0);
    return n ? {c, n} : null;
  });
  const avgRow = `<tr class="avg"><td>Average<br><span class="dim" style="font-weight:400;font-size:.72rem">completed weeks only</span></td><td class="base"></td>${avg.map(x => x ? `<td>${coh.view === 'pct' ? pct(x.c/x.n) : fmt(x.c)}<small style="display:block;font-weight:400;color:var(--muted);font-size:.7rem">${x.c} of ${x.n}</small></td>` : '<td></td>').join('')}</tr>`;
  $('cohort').innerHTML = `<div class="tblwrap"><table class="coh"><thead>${head}</thead><tbody>${body}${avgRow}</tbody></table></div>`;
}

function groupTable(rows, keyFn, cols){
  const g = {};
  rows.forEach(r => { const k = keyFn(r); (g[k] = g[k] || {k, rows:[]}).rows.push(r); });
  const den = $('fDen').value === 'assigned';
  const list = Object.values(g).map(x => {
    const rs = x.rows, d = den ? rs.filter(r => r.assigned) : rs, dates = rs.map(r => r.created).sort();
    return {...x, n:rs.length, a:rs.filter(r=>r.assigned).length, d:d.length, o:d.filter(r=>r.onboarded).length, f:d.filter(r=>r.fls).length, act:rs.filter(r=>r.active).length, first:dates[0], last:dates[dates.length-1]};
  }).sort((p,q) => q.n - p.n);
  if (!list.length) return '<div class="empty">No leads in the current filters.</div>';
  const w = den ? 'of assigned' : 'of leads';
  return `<div class="tblwrap"><table><thead><tr>${cols.map(c => `<th>${c[0]}</th>`).join('')}<th>Leads</th><th>Assigned</th><th>Onboarded (${w})</th><th>First lead shared (${w})</th><th>First active</th><th>Leads from</th></tr></thead><tbody>
  ${list.map(x => `<tr>${cols.map(c => `<td>${c[1](x)}</td>`).join('')}<td>${fmt(x.n)}</td><td>${pct(x.a/x.n,0)}</td><td>${x.o} <span class="dim">(${pct(x.d ? x.o/x.d : null)})</span></td><td>${x.f} <span class="dim">(${pct(x.d ? x.f/x.d : null)})</span></td><td>${x.act}</td><td class="dim">${shortDate(x.first)} – ${shortDate(x.last)}</td></tr>`).join('')}
  </tbody></table></div>`;
}
function renderTables(rows){
  $('formTbl').innerHTML = groupTable(rows, r => r.form, [['Form version', x => esc(x.k)]]);
  $('adTbl').innerHTML = groupTable(rows, r => r.ad, [['Ad ID', x => esc(x.k)], ['Ad set', x => esc([...new Set(x.rows.map(r=>r.adset))].join(', '))]]);
}

/* ---------- wiring ---------- */
['fFrom','fTo','fFlag','fForm','fAdset','fAd','fAge','fDen','fMinN'].forEach(id => $(id).addEventListener('change', render));
$('hQ1').addEventListener('change', () => renderHeat(outcomeBase(filtered())));
$('hQ2').addEventListener('change', () => renderHeat(outcomeBase(filtered())));
$('outSeg').addEventListener('click', e => {
  const b = e.target.closest('button'); if (!b) return;
  state.outcome = b.dataset.o;
  $('outSeg').querySelectorAll('button').forEach(x => x.setAttribute('aria-pressed', x === b ? 'true' : 'false'));
  render();
});
$('reset').addEventListener('click', () => {
  FILTERS.forEach(([id]) => $(id).value = '');
  $('fAge').value = '0'; $('fDen').value = 'assigned'; $('fMinN').value = '10';
  $('fFrom').value = $('fFrom').min; $('fTo').value = $('fTo').max;
  render();
});
$('reload').addEventListener('click', load);
[['cohOut','out'],['cohView','view']].forEach(([id, key]) => $(id).addEventListener('click', e => {
  const b = e.target.closest('button'); if (!b) return;
  coh[key] = b.dataset.v;
  $(id).querySelectorAll('button').forEach(x => x.setAttribute('aria-pressed', x === b ? 'true' : 'false'));
  renderWeekly(filtered());
}));
load();
</script>
</body>
</html>
