function normalize(raw){
  const out = [], seen = new Set();
  for (const r of raw){
    const id = pick(r, ['_id','id']);
    if (id){ if (seen.has(id)) continue; seen.add(id); }
    if (CAMPAIGN_PREFIX && !pick(r, ['campaignName']).startsWith(CAMPAIGN_PREFIX)) continue;
    const createdISO = pick(r, ['createdAt','created_at']);
    const created = toDate(createdISO);
    if (!created) continue;
    let phone = pick(r, ['phone_key']);
    if (!phone) phone = pick(r, ['phoneNumber','phone_number']).replace(/\D/g,'').slice(-10);
    const answers = {}; let pin = '';
    const bt = pick(r, ['businessType','business_type']);
    if (bt){
      try {
        for (const q of JSON.parse(bt)){
          const v = (q.values && q.values.length && q.values[0] != null) ? String(q.values[0]).trim() : '';
          if (q.name === 'post_code') pin = v;
          else if (v) answers[q.name] = prettyAnswer(v);
        }
      } catch(e){}
    }
    const pinOk = /^[1-9]\d{5}$/.test(pin);
    answers.__pin_valid = !pin ? 'Not given' : pinOk ? 'Valid 6-digit' : 'Invalid';
    if (pinOk) answers.__region = PIN_REGION[pin[0]];
    const flagRaw = pick(r, ['partner_team_flag']).toUpperCase();
    out.push({
      id, phone, createdISO, created,
      form: pick(r, ['formName']) || '(no form)',
      campaign: pick(r, ['campaignName']) || '(no campaign)',
      adset: pick(r, ['adSetname','adSetName']) || '(no ad set)',
      ad: pick(r, ['adId']) || '(no ad)',
      flag: flagRaw === 'AP' ? 'AP' : flagRaw === 'TP' ? 'TP' : 'Unflagged',
      assigned: /^assigned$/i.test(pick(r, ['is_assigned'])),
      onboarded: /^onboarded$/i.test(pick(r, ['is_onboared','is_onboarded'])),
      onbType: pick(r, ['onboarding_type']),
      onbDate: toDate(pick(r, ['dis_created_at'])),
      flsDate: toDate(pick(r, ['first_lead_date'])),
      fls: !!toDate(pick(r, ['first_lead_date'])),
      active: !!toDate(pick(r, ['first_active_date'])),
      answers
    });
  }
  // keep earliest submission per phone
  out.sort((a,b) => a.createdISO < b.createdISO ? -1 : 1);
  const seenPhone = new Set(), rows = []; let dupPhones = 0;
  for (const r of out){
    if (r.phone){ if (seenPhone.has(r.phone)){ dupPhones++; continue; } seenPhone.add(r.phone); }
    rows.push(r);
  }
  return {rows, dupPhones};
}

