function qstats(rows, key, y){
  const g = {}; let n = 0, yes = 0;
  for (const r of rows){
    const a = r.answers[key]; if (a == null) continue;
    (g[a] = g[a] || {a, n:0, y:0}); g[a].n++; n++;
    if (y(r)){ g[a].y++; yes++; }
