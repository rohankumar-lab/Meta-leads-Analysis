  const answers = Object.values(g);
  const base = n ? yes/n : 0;
  answers.forEach(x => { x.rate = x.n ? x.y/x.n : 0; [x.lo, x.hi] = wilson(x.y, x.n); x.lift = base ? x.rate/base : null; });
  answers.sort((a,b) => b.rate - a.rate || b.n - a.n);
  let chi2 = 0, lowExp = 0, cells = 0, V = null, p = null;
  const testable = answers.length > 1 && yes >= 5 && (n - yes) >= 5;
  if (testable){
    for (const x of answers){
      const e1 = x.n*base, e0 = x.n*(1-base);
      chi2 += (x.y - e1)**2/e1 + ((x.n-x.y) - e0)**2/e0;
      cells += 2; if (e1 < 5) lowExp++; if (e0 < 5) lowExp++;
