  const live = await fetchSheet();
  setBar(70);
  let raw, src;
  if (live){ raw = live.rows; src = `<b>Live Google Sheet</b> (${live.via}), fetched ${new Date().toLocaleString('en-IN', {timeZone:'Asia/Kolkata', dateStyle:'medium', timeStyle:'short'})}`; }
  else { raw = SNAPSHOT; src = SHEET_CSV_URL ? `<span class="warn">Sheet could not be reached.</span> Showing the saved snapshot from ${SNAPSHOT_DATE}` : `Saved snapshot from ${SNAPSHOT_DATE}. Add the sheet link in <code>SHEET_CSV_URL</code> for live data`; }
