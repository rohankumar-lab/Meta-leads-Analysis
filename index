function parseCSV(text){ return Papa.parse(text, {header:true, skipEmptyLines:true}).data; }
async function fetchSheet(){
  if (!SHEET_CSV_URL) return null;
  const tries = [SHEET_CSV_URL, PROXY(SHEET_CSV_URL)];
  for (const u of tries){
    try {
      const res = await fetch(u, {cache:'no-store'});
      if (!res.ok) continue;
      const text = await res.text();
      if (!text || /^\s*</.test(text)) continue; // HTML error page, not CSV
      const rows = parseCSV(text);
      if (rows.length && ('createdAt' in rows[0] || 'businessType' in rows[0])) return {rows, via: u === SHEET_CSV_URL ? 'direct' : 'proxy'};
    } catch (e) { /* try next */ }
  }
  return null;
}
async function load(){
  setBar(20);
